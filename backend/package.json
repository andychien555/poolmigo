{
  "name": "@mysun/keeper",
  "version": "0.1.0",
  "private": true,
  "description": "MySun vault keeper service — executes deployTo() and rebalance() on a schedule.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.5.1",
  "main": "dist/cli.js",
  "scripts": {
    "sync-abis": "node scripts/sync-abis.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js run",
    "tick": "node dist/cli.js tick",
    "dev:tick": "tsx src/cli.ts tick",
    "dev:collect-nav": "tsx src/collect-nav-cli.ts once",
    "dev:collect-nav-serve": "tsx src/collect-nav-cli.ts serve",
    "collect-nav": "node dist/collect-nav-cli.js once",
    "dev:run": "tsx src/cli.ts run",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
