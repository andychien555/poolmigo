####################################################################################################
# MySun keeper — configuration
#
# Copy to `.env` and edit. Every variable is optional unless marked REQUIRED; defaults are shown.
# `.env` is NOT read automatically — the process reads the real environment. Load it with
# `set -a; . ./.env; set +a`, `docker compose --env-file`, or your supervisor's EnvironmentFile.
#
# NEVER commit a file containing a real key. See README.md "Secret handling".
####################################################################################################

# ---------------------------------------------------------------------------------------------
# Chain / contract
# ---------------------------------------------------------------------------------------------
#
# Which chain — and which vault on it — the keeper acts on comes from the monorepo chain registry,
# shared/deployments.json (schema v2) — the SAME registry the frontend uses (per-chain name / rpcUrl
# / testnet / status + a `vaults` list: key, label, receipt name/symbol, addresses), with
# shared/deployment.local.json (the local demo stack: vaults "demo" + "stocks") overlaid onto the
# entry with its chainId.
#
# Chain selection:  env CHAIN_ID  >  the registry's local entry  >  the first deployed chain
#                   (ascending chain id). A "planned" chain is refused — it has no vault yet.
# Vault selection:  env VAULT (a key)  >  the selected chain's FIRST vault. Unknown key = exit 2.
# Per value:        env CHAIN_ID / RPC_URL  >  the selected chain entry;
#                   env VAULT_ADDRESS  >  the selected VAULT's address (see VAULT below).
#
# ONE KEEPER PROCESS PER VAULT. Two vaults = two processes (or two containers), same code, each with
# its own VAULT (or VAULT_ADDRESS) and its own STATE_FILE.
#
# Running from the monorepo, all three below may be left unset (comment them out) and the registry
# supplies them. In a CONTAINER there is no ../shared: set all three — the registry is then
# optional and, when present, only names the chain. The values below are the local demo stack.

# JSON-RPC endpoint. Default: the selected registry entry's rpcUrl.
RPC_URL=http://127.0.0.1:8547

# Chain to act on. Default: the registry's local entry, else its first deployed chain.
# Robinhood Chain mainnet = 4663 (registry status: planned), local anvil demo stack = 46630.
# Must be "deployed" in the registry unless RPC_URL and VAULT_ADDRESS are set too.
# Checked against the RPC at preflight; a mismatch aborts before any action.
CHAIN_ID=46630

# Which vault on the selected chain, by registry key (local demo stack: demo | stocks).
# Default: the chain's FIRST vault in registry order. An unknown key fails with exit 2 and lists
# the available keys. Needs a registry to resolve against (fails without one — env-only containers
# leave it unset and are identified by VAULT_ADDRESS alone).
#VAULT=stocks

# The vault PROXY address. Default: the selected vault's `vault` address.
# PRECEDENCE: VAULT picks the vault; VAULT_ADDRESS only overrides that vault's ADDRESS — it never
# changes which vault is selected. It may not be the address of a DIFFERENT vault the registry lists
# on the chain (exit 2: "set VAULT=<key>, or unset VAULT_ADDRESS"). Acting on the stocks vault from
# the values below therefore means VAULT=stocks AND VAULT_ADDRESS=0x59b670e9fA9D0A427751Af201D676719a970857b
# (or comment VAULT_ADDRESS out and let the registry supply it).
VAULT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# The chain registry. Default: ../shared/deployments.json. A missing default file is fine when
# the three vars above are set; a file that exists but is invalid is always an error.
#DEPLOYMENTS_FILE=../shared/deployments.json

# The local-stack overlay. Default: deployment.local.json next to DEPLOYMENTS_FILE.
# Without a registry on disk, a flat file here still supplies vault/chainId/rpcUrl (as before).
#DEPLOYMENT_FILE=../shared/deployment.local.json

# ---------------------------------------------------------------------------------------------
# Keeper identity  (exactly one signing source; or none, for a read-only monitor)
# ---------------------------------------------------------------------------------------------

# LOCAL DEMO ONLY. This is Anvil account #1, the publicly known test key used by the demo stack.
# It is inert and must NEVER be funded on a real network. In production use KEEPER_KEY_FILE with a
# secret-manager-mounted file, or an external signer — see README.md.
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Alternative to KEEPER_PRIVATE_KEY: path to a file containing only the hex key (0x optional).
# Intended for Docker/Kubernetes secret mounts, e.g. /run/secrets/keeper_key. Mode 0400, non-root.
#KEEPER_KEY_FILE=/run/secrets/keeper_key

# Address the keeper acts as. Derived from the key when one is set (and must match it if both are).
# Set this ALONE to run a signer-less dry-run monitor: it observes and simulates but cannot send.
#KEEPER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# ---------------------------------------------------------------------------------------------
# Safety / scheduling
# ---------------------------------------------------------------------------------------------

# true  = observe, plan and simulate only; never send a transaction. THE DEFAULT.
# false = send transactions. Always run a dry-run tick against a new deployment first.
DRY_RUN=true

# Seconds between ticks in `run` mode. After consecutive failing ticks the loop backs this off.
TICK_INTERVAL_SEC=60

# Seconds between harvests. A harvest runs on the first tick after this has elapsed since the last
# CONFIRMED rebalance() (dry runs and failures do not advance the gate). 0 = every tick.
REBALANCE_INTERVAL_SEC=86400

# ---------------------------------------------------------------------------------------------
# Policy  (see README "Strategy" and src/policy.ts — conservative plumbing, not alpha)
# ---------------------------------------------------------------------------------------------

# Fraction of each token's TOTAL holding (idle + all adapter positions) to keep idle in the vault,
# as a redemption buffer. 2000 = 20%.
TARGET_IDLE_BPS=2000

# Per-tick ceiling on how much of each token's TOTAL holding may be moved into adapters.
# 5000 = at most 50% per tick; successive ticks converge on TARGET_IDLE_BPS geometrically.
MAX_DEPLOY_PER_TICK_BPS=5000

# How the per-token budget is split across adapters. Unset = equal across every registered adapter.
#   positional : "1,3"                          aligned to vault.adapters() order
#   by address : "0xAdapterA:1,0xAdapterB:3"    RECOMMENDED
# `removeAdapter` uses swap-and-pop, so a positional list silently re-targets itself when the
# adapter registry changes; the keyed form does not. A weight of 0 means "never fund this adapter".
#ADAPTER_WEIGHTS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9:1,0x5FC8d32690cc91D4c39d9d3abcBD16989F875707:1

# Minimum per-adapter, per-token amount worth deploying, in RAW token units (dust guard: below this
# the gas is not worth the move). Accepts a scalar, or per-token floors — the latter matters because
# basket tokens have different decimals (e.g. 6dp USDG vs 18dp WETH).
#   scalar     : "0"
#   per token  : "default:0,0x5FbDB...:1000000,0xe7f17...:10000000000000000"
MIN_DEPLOY_AMOUNT_RAW=0

# ---------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------

# Durable scheduling state (last tick / last harvest / last tx hashes). Written atomically.
# In Docker, put this on a volume so a restart does not re-harvest immediately.
# ONE PER VAULT: it holds the harvest gate. Default: .keeper-state.json, or .keeper-state.<VAULT>.json
# when VAULT is set. When you set it explicitly for two vaults, give each its own path/volume.
#STATE_FILE=.keeper-state.json

# debug | info | warn | error. Structured JSON, one object per line, on stdout.
LOG_LEVEL=info

# Receipt confirmations to wait for before declaring a transaction done.
CONFIRMATIONS=1

# Seconds to wait for a receipt before giving up on a sent transaction.
TX_TIMEOUT_SEC=120

# Retries for a failed RPC operation, and the exponential-backoff base delay (full jitter).
# Contract reverts are never retried — only transport/network failures.
RPC_MAX_RETRIES=4
RPC_BACKOFF_BASE_MS=500
